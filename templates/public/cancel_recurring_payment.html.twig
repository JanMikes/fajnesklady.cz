{% extends 'user/layout.html.twig' %}

{% block title %}Platba kartou - Fajnesklady.cz{% endblock %}

{% block content %}
<div class="max-w-lg mx-auto">
    <div class="card">
        <div class="card-body">
            {% if alreadyCancelled is defined and alreadyCancelled %}
                {# Already cancelled state #}
                <div class="text-center">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-gray-100 rounded-full mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h1 class="text-2xl font-bold text-gray-900 mb-2">Platba kartou již byla zrušena</h1>
                    <p class="text-gray-600 mb-4">
                        Z Vaší karty už nic nestrháváme. Nájem tím nekončí a platby za něj je potřeba hradit i nadále.
                    </p>
                    {% if summary is defined %}
                        {{ include('public/_card_payment_stop_summary.html.twig') }}
                    {% endif %}
                </div>

            {% elseif success is defined and success %}
                {# Success state #}
                <div class="text-center">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-green-100 rounded-full mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                    </div>
                    <h1 class="text-2xl font-bold text-gray-900 mb-2">Platba kartou zrušena</h1>
                    <p class="text-gray-600 mb-4">
                        Z Vaší karty už nebudeme nic strhávat. <strong>Nájem tím nekončí</strong> — smlouva trvá dál a platby za ni je potřeba hradit (Podmínky opakovaných plateb čl. VI).
                    </p>
                    {{ include('public/_card_payment_stop_summary.html.twig') }}
                    <p class="text-sm text-gray-500">
                        V případě dotazů nás kontaktujte na <a href="mailto:simek@fajnesklady.cz" class="text-accent hover:underline">simek@fajnesklady.cz</a>, tel. 774 302 684.
                    </p>
                </div>

            {% elseif error is defined and error %}
                {# Error state #}
                <div class="text-center">
                    <div class="inline-flex items-center justify-center w-16 h-16 bg-red-100 rounded-full mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h1 class="text-2xl font-bold text-gray-900 mb-2">Něco se pokazilo</h1>
                    <p class="text-gray-600 mb-4">
                        Při rušení opakované platby došlo k chybě. Zkuste to prosím znovu nebo nás kontaktujte.
                    </p>
                    <p class="text-sm text-gray-500">
                        Kontakt: <a href="mailto:simek@fajnesklady.cz" class="text-accent hover:underline">simek@fajnesklady.cz</a>, tel: 774 302 684
                    </p>
                </div>

            {% else %}
                {# Confirmation form #}
                <div class="text-center mb-6">
                    <h1 class="text-2xl font-bold text-gray-900 mb-2">Měníte platební kartu?</h1>
                    <p class="text-gray-600">
                        Skladová jednotka <strong>{{ contract.storage.storageType.name }} č. {{ contract.storage.number }}</strong> se platí automaticky kartou.
                    </p>
                </div>

                <div class="text-sm text-gray-700 mb-4 space-y-1">
                    {% if summary.paidThroughDate %}
                        <p>Zaplaceno do: <strong>{{ summary.paidThroughDate|date('d.m.Y') }}</strong></p>
                    {% endif %}
                    <p>Smlouva trvá do: <strong>{{ contract.endDate|date('d.m.Y') }}</strong></p>
                </div>

                <form method="post" class="mb-6">
                    <input type="hidden" name="action" value="change_card">
                    <button type="submit" class="btn btn-primary w-full justify-center">
                        Změnit platební kartu
                    </button>
                    <p class="text-xs text-gray-500 mt-2 text-center">Stávající karta se zruší a hned nastavíte novou.</p>
                </form>

                <div class="bg-amber-50 border border-amber-200 rounded-lg p-4 mb-4 text-sm text-gray-700">
                    <p class="font-semibold mb-1">Chcete platby kartou úplně zrušit?</p>
                    <ul class="list-disc pl-5 space-y-1">
                        <li>Z karty už nebudeme nic strhávat.</li>
                        <li>Nájem tím <strong>nekončí</strong> — smlouva trvá do {{ contract.endDate|date('d.m.Y') }} a platby je potřeba hradit dál, nově bankovním převodem podle údajů, které Vám pošleme e-mailem.</li>
                        <li>Neuhrazená platba po splatnosti může vést k ukončení smlouvy podle čl. XI Všeobecných obchodních podmínek.</li>
                    </ul>
                </div>

                <div class="flex gap-4">
                    <a href="{{ path('app_home') }}" class="btn btn-secondary flex-1 justify-center">
                        Zpět
                    </a>
                    <form method="post" class="flex-1">
                        <input type="hidden" name="action" value="cancel">
                        <button type="submit" class="btn btn-secondary w-full justify-center text-red-700">
                            Zrušit platbu kartou
                        </button>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
